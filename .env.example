# Zelo — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# Encontre esses valores no painel do Supabase em: Project Settings > API

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
